# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Needed only for ConfoundingSHAP with TabPFN-2.5 (see README, Setup). Also accepted: TABPFN_TOKEN, HF_TOKEN.
# HuggingFace is a read token; `hf auth login` in a terminal works instead and then this can stay empty.
TabPFNAPI=
HuggingFace=

# Pipeline settings
DATA_DIR=./02_data
OUTPUT_DIR=./outputs
RANDOM_SEED=42
LOG_LEVEL=INFO
